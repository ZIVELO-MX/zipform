model TlozDomainCutover {
  key           String   @id @default("domain")
  source        String   @default("legacy")
  writesEnabled Boolean  @default(true)
  reason        String   @default("")
  updatedBy     String?
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@map("tloz_domain_cutover")
}

model TlozDomainCutoverObservation {
  bucket    DateTime @db.Date
  source    String
  operation String
  count     BigInt   @default(0)
  lastAt    DateTime @default(now())

  @@id([bucket, source, operation])
  @@index([source, bucket])
  @@map("tloz_domain_cutover_observations")
}
