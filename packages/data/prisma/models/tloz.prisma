model TlozSeason {
  id          String        @id
  name        String
  version     String
  description String
  status      String
  startDate   String
  endDate     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  episodes    TlozEpisode[]
  missions    TlozMission[]

  @@map("tloz_seasons")
}

model TlozEpisode {
  id          String        @id
  seasonId    String
  season      TlozSeason    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name        String
  romanNumber String
  description String
  status      String
  startDate   String
  endDate     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  missions    TlozMission[]

  @@index([seasonId])
  @@map("tloz_episodes")
}

model TlozProject {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  name              String
  description       String
  descriptionDetail String        @default("")
  color             String
  icon              String
  status            String
  type              String        @default("normal")
  ownerId     String    @db.Uuid
  owner       User      @relation(fields: [ownerId], references: [id])
  startDate   String
  dueDate     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  missions    TlozMission[]
  resources   TlozResource[]

  @@index([ownerId])

  @@map("tloz_projects")
}

model TlozMission {
  id                 String                  @id @default(uuid()) @db.Uuid
  displayId          String                  @unique
  title              String
  description        String
  descriptionDetail  String                  @default("")
  icon               String
  type               String
  status             String
  ownerId            String    @db.Uuid
  owner              User      @relation(fields: [ownerId], references: [id])
  projectId          String?
  project            TlozProject?            @relation(fields: [projectId], references: [id])
  seasonId           String?
  season             TlozSeason?             @relation(fields: [seasonId], references: [id])
  episodeId          String?
  episode            TlozEpisode?            @relation(fields: [episodeId], references: [id])
  dueDate            String?
  startDate          String?
  completedAt        DateTime?
  blockedReason      String?
  progress           Int
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  dependencies       TlozMissionDependency[] @relation("MissionDependencies")
  dependedOnBy       TlozMissionDependency[] @relation("MissionDependents")
  missionQuestItems  TlozMissionQuestItem[]
  checklistItems     TlozChecklistItem[]
  resources          TlozResource[]
  attachmentBatches  TlozAttachmentBatch[]
  userMissionStates  TlozUserMissionState[]

  @@index([ownerId])
  @@index([projectId])
  @@index([seasonId])
  @@index([episodeId])
  @@map("tloz_missions")
}

model TlozMissionDependency {
  id                 String      @id
  missionId          String
  mission            TlozMission @relation("MissionDependencies", fields: [missionId], references: [id], onDelete: Cascade)
  dependsOnMissionId String
  dependsOnMission   TlozMission @relation("MissionDependents", fields: [dependsOnMissionId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())

  @@unique([missionId, dependsOnMissionId])
  @@index([dependsOnMissionId])
  @@map("tloz_mission_dependencies")
}

model TlozQuestItem {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String
  description       String
  descriptionDetail String                 @default("")
  icon              String
  status            String
  category          String                 @default("other")
  ownerId           String?   @db.Uuid
  owner             User?     @relation(fields: [ownerId], references: [id])
  acquiredAt        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  missionQuestItems TlozMissionQuestItem[]
  resources         TlozResource[]

  @@index([ownerId])

  @@map("tloz_quest_items")
}

model TlozMissionQuestItem {
  id          String        @id
  missionId   String
  mission     TlozMission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  questItemId String
  questItem   TlozQuestItem @relation(fields: [questItemId], references: [id], onDelete: Cascade)
  required    Boolean
  createdAt   DateTime      @default(now())

  @@unique([missionId, questItemId])
  @@index([questItemId])
  @@map("tloz_mission_quest_items")
}

model TlozChecklistItem {
  id        String      @id
  missionId String
  mission   TlozMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  title     String
  completed Boolean
  position  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([missionId])
  @@map("tloz_checklist_items")
}

model TlozResource {
  id        String      @id
  documentId String?     @db.Uuid
  document   TlozDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  missionId String?
  mission   TlozMission? @relation(fields: [missionId], references: [id], onDelete: Cascade)
  projectId String?
  project   TlozProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questItemId String?
  questItem TlozQuestItem? @relation(fields: [questItemId], references: [id], onDelete: Cascade)
  type      String
  icon      String?
  title     String
  url       String?
  fileId    String?
  groupKey String?
  externalKey String?
  storagePath String?
  contentType String?
  sizeBytes Int?
  width Int?
  height Int?
  sourceRevision String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([documentId])
  @@index([missionId])
  @@index([projectId])
  @@index([questItemId])
  @@unique([missionId, groupKey, externalKey])
  @@map("tloz_resources")
}

model TlozAttachmentBatch {
  id             String      @id
  missionId      String
  mission        TlozMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  groupKey       String
  sourceRevision String
  generation     Int
  status         String
  manifest       Json
  finalizedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([missionId, groupKey, sourceRevision])
  @@unique([missionId, groupKey, generation])
  @@index([missionId, groupKey, generation])
  @@map("tloz_attachment_batches")
}

model TlozUserMissionState {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   TlozMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  slot      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, slot])
  @@index([missionId])
  @@map("tloz_user_mission_states")
}

model TlozDocument {
  id                String                   @id @default(uuid()) @db.Uuid
  publicId          String                   @unique
  kind              String
  projectId         String?                  @db.Uuid
  project           TlozDocument?            @relation("DocumentProject", fields: [projectId], references: [id], onDelete: Restrict)
  children          TlozDocument[]           @relation("DocumentProject")
  title             String
  summary           String                   @default("")
  body              String                   @default("")
  revision          Int                      @default(1)
  sourceType        String?
  sourceId          String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  projectDocument   TlozProjectDocument?
  missionDocument   TlozMissionDocument?
  inventoryDocument TlozInventoryDocument?
  fieldValues       TlozFieldValue[]         @relation("DocumentFieldValues")
  relationValues    TlozFieldValue[]         @relation("RelatedDocumentFieldValues")
  outgoingRelations TlozDocumentRelation[]   @relation("DocumentRelationsFrom")
  incomingRelations TlozDocumentRelation[]   @relation("DocumentRelationsTo")
  resources         TlozResource[]
  ownedDefinitions  TlozDocumentDefinition[]

  @@unique([sourceType, sourceId])
  @@index([kind, projectId])
  @@index([updatedAt])
  @@map("tloz_documents")
}

model TlozDocumentDefinition {
  id              String       @id @default(uuid()) @db.Uuid
  key             String       @unique
  kind            String
  scope           String
  ownerDocumentId String?      @db.Uuid
  ownerDocument   TlozDocument? @relation(fields: [ownerDocumentId], references: [id], onDelete: Cascade)
  fields          Json
  views           Json
  defaultView     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([kind, scope])
  @@index([ownerDocumentId])
  @@map("tloz_document_definitions")
}

model TlozProjectDocument {
  documentId      String                @id @db.Uuid
  document        TlozDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  slug            String                @unique
  ownerId         String?               @db.Uuid
  color           String                @default("#6B6B6B")
  icon            String                @default("FolderKanban")
  status          String                @default("active")
  projectType     String                @default("normal")
  startDate       String?
  dueDate         String?
  fieldDefinitions TlozFieldDefinition[]
  statusOptions   TlozStatusOption[]
  missions        TlozMissionDocument[]
  inventoryItems  TlozInventoryDocument[]

  @@index([ownerId])
  @@map("tloz_project_documents")
}

model TlozMissionDocument {
  documentId  String              @id @db.Uuid
  document    TlozDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId   String              @db.Uuid
  project     TlozProjectDocument @relation(fields: [projectId], references: [documentId], onDelete: Restrict)
  ownerId     String              @db.Uuid
  category    String
  status      String
  icon        String              @default("Sword")
  startDate   String?
  dueDate     String?
  completedAt DateTime?
  blockedReason String?
  progress    Int                 @default(0)

  @@index([projectId, status])
  @@index([ownerId])
  @@map("tloz_mission_documents")
}

model TlozInventoryDocument {
  documentId  String              @id @db.Uuid
  document    TlozDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId   String              @db.Uuid
  project     TlozProjectDocument @relation(fields: [projectId], references: [documentId], onDelete: Restrict)
  ownerId     String?             @db.Uuid
  category    String              @default("other")
  status      String              @default("locked")
  icon        String              @default("PackageOpen")
  acquiredAt  String?

  @@index([projectId, status])
  @@index([ownerId])
  @@map("tloz_inventory_documents")
}

model TlozFieldDefinition {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @db.Uuid
  project        TlozProjectDocument @relation(fields: [projectId], references: [documentId], onDelete: Cascade)
  key            String
  label          String
  fieldType      String
  required       Boolean             @default(false)
  visible        Boolean             @default(true)
  position       Int
  defaultValue   Json?
  options        Json?
  retiredAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  values         TlozFieldValue[]

  @@unique([projectId, key])
  @@index([projectId, position])
  @@map("tloz_field_definitions")
}

model TlozFieldValue {
  id                  String              @id @default(uuid()) @db.Uuid
  documentId          String              @db.Uuid
  document            TlozDocument        @relation("DocumentFieldValues", fields: [documentId], references: [id], onDelete: Cascade)
  fieldDefinitionId   String              @db.Uuid
  fieldDefinition     TlozFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)
  stringValue         String?
  numberValue         Decimal?
  booleanValue        Boolean?
  dateValue           DateTime?
  stringListValue     String[]            @default([])
  personId            String?             @db.Uuid
  relatedDocumentId   String?             @db.Uuid
  relatedDocument     TlozDocument?       @relation("RelatedDocumentFieldValues", fields: [relatedDocumentId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([documentId, fieldDefinitionId])
  @@index([fieldDefinitionId, stringValue])
  @@index([fieldDefinitionId, numberValue])
  @@index([fieldDefinitionId, booleanValue])
  @@index([fieldDefinitionId, dateValue])
  @@index([personId])
  @@index([relatedDocumentId])
  @@map("tloz_field_values")
}

model TlozStatusOption {
  id        String              @id @default(uuid()) @db.Uuid
  projectId String              @db.Uuid
  project   TlozProjectDocument @relation(fields: [projectId], references: [documentId], onDelete: Cascade)
  key       String
  label     String
  role      String
  color     String?
  position  Int
  active    Boolean             @default(true)

  @@unique([projectId, key])
  @@index([projectId, role])
  @@map("tloz_status_options")
}

model TlozDocumentRelation {
  id             String       @id @default(uuid()) @db.Uuid
  sourceDocumentId String     @db.Uuid
  sourceDocument TlozDocument @relation("DocumentRelationsFrom", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocumentId String     @db.Uuid
  targetDocument TlozDocument @relation("DocumentRelationsTo", fields: [targetDocumentId], references: [id], onDelete: Cascade)
  relationType   String
  required       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([sourceDocumentId, targetDocumentId, relationType])
  @@index([targetDocumentId, relationType])
  @@map("tloz_document_relations")
}
